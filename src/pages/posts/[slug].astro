---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { 
      post, 
      relatedPosts: posts
        .filter(p => p.slug !== post.slug && p.data.category === post.data.category)
        .slice(0, 3) 
    },
  }));
}

const { post, relatedPosts } = Astro.props;
const { Content, headings } = await post.render();

// Cálculo automático de tiempo de lectura (aprox 200 palabras por minuto)
const plainText = post.body || "";
const wordCount = plainText.split(/\s+/g).length;
const readingTime = Math.ceil(wordCount / 200);
---

<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.data.title} - Cubosite 🧊</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- 1. Barra de Progreso de Lectura -->
    <div id="readingProgress" class="reading-progress"></div>

    <!-- Barra de Navegación -->
    <header class="navbar">
      <div class="nav-container">
        <a href="/" class="logo">Cubosite 🧊</a>
        
        <div class="search-box">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="🔍 Buscar publicaciones..." 
            autocomplete="off"
          />
        </div>

        <nav class="nav-links">
          <a href="/">Inicio</a>
          <a href="/#terror" class="filter-btn" data-category="Terror">Terror</a>
          <a href="/#comedia" class="filter-btn" data-category="Comedia">Comedia</a>
          <a href="/#ficcion" class="filter-btn" data-category="Ficcion">Ficción</a>
          <a href="/#drama" class="filter-btn" data-category="Drama">Drama</a>
          <a href="/#accion" class="filter-btn" data-category="Accion">Acción</a>
          <a href="/#suspenso" class="filter-btn" data-category="Suspenso">Suspenso</a>
          <a href="/#archivos" class="filter-btn" data-category="+Archivos">+Archivos</a>
        </nav>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="container">
      <section class="hero">
        <div class="hero-top-bar">
          <div class="theme-switchers">
            <button class="theme-btn active" data-theme-target="dark">🌙 Dark</button>
            <button class="theme-btn" data-theme-target="light">☀️ Gris Claro</button>
            <button class="theme-btn" data-theme-target="green">🟢 Green</button>
          </div>
          
          <div class="info-widget">
            <span id="liveClock">🕒 Cargando...</span>
            <span class="divider">|</span>
            <span id="widget-clima">⛅ Cargando...</span>
            <span class="divider">|</span>
            <span id="userIp">🌐 IP: Cargando...</span>
          </div>
        </div>
      
       <h1>Bitácora y Exploración Digital</h1>
       <p>Un espacio propio para almacenar películas, videos, reflexiones y noticias sin depender de plataformas corporativas.</p>
      </section>

      <!-- Tarjeta del Artículo -->
      <section class="content-section">
        <article class="post-container">
          <span class="tag">{post.data.category}</span>
          <h1 class="post-title">{post.data.title}</h1>
          
          <div class="post-meta-info">
            <span class="date">📅 Publicado el {post.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            <span class="dot">•</span>
            <span class="read-time">⏱️ Tiempo de lectura: {readingTime} min</span>
          </div>

          <!-- Tabla de Contenidos (TOC) Automática si hay subtítulos -->
          {headings.length > 0 && (
            <div class="toc-box">
              <h3>Índice de Contenido</h3>
              <ul>
                {headings.map((h) => (
                  <li><a href={`#${h.slug}`}>{h.text}</a></li>
                ))}
              </ul>
            </div>
          )}

          <div class="post-content">
            <Content />
          </div>

          <!-- Sistema de Reacciones con Cubitos 🧊 y Compartir -->
          <div class="post-actions-bar">
            <button id="likeBtn" class="action-btn">
              🧊 Reaccionar (<span id="likeCount">0</span>)
            </button>
            <button id="shareBtn" class="action-btn">
              🔗 Copiar Enlace
            </button>
          </div>
          <p id="copyToast" class="toast-msg" style="display: none;">¡Enlace copiado al portapapeles con éxito! 🧊</p>

          <div style="margin-top: 2.5rem; border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
            <a href="/" class="btn-back">← Volver a todas las publicaciones</a>
          </div>
        </article>

        <!-- Artículos Relacionados -->
        {relatedPosts.length > 0 && (
          <div class="related-section">
            <h3>Artículos Relacionados en {post.data.category}</h3>
            <div class="related-grid">
              {relatedPosts.map((rel) => (
                <a href={`/posts/${rel.slug || rel.id}`} class="related-card">
                  <h4>{rel.data.title}</h4>
                  <p>{rel.data.description}</p>
                  <span class="date">{rel.data.date.toLocaleDateString('es-ES', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </section>
    </main>

    <!-- Footer Avanzado en 3 Columnas -->
    <footer class="footer-advanced">
      <div class="footer-container">
        <div class="footer-col">
          <h3>Cubosite 🧊</h3>
          <p>Plataforma web multitema construida con Astro SSG y desplegada de forma independiente. Contenido autogestionado por Cubo.</p>
          <span class="footer-badge">Estado: 100% Operativo 🚀</span>
        </div>

        <div class="footer-col">
          <h4>Contacto & Enlaces</h4>
          <ul>
            <li><a href="/">📩 Soporte / Reportar Error</a></li>
            <li><a href="https://github.com" target="_blank">🐙 Repositorio GitHub</a></li>
            <li><a href="/">💡 Sugerir Contenido</a></li>
            <li><a href="/">📜 Manual SKILL.md</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Actualizaciones & Búsqueda</h4>
          <p class="update-info">Versión: <strong>v3.7 Post Avanzado</strong></p>
          
          <div class="footer-search-box">
            <input 
              type="text" 
              id="searchInputBottom" 
              placeholder="🔍 Búsqueda rápida abajo..." 
              autocomplete="off"
            />
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p>Hecho con 🧊 y Astro por Cubo. Todos los derechos reservados.</p>
      </div>
    </footer>

    <!-- Script con Reloj, Clima, Progreso, Reacciones y Copiar Enlace -->
    <script>
      // 1. Reloj
      function updateClock() {
        const clockElement = document.getElementById('liveClock');
        if (clockElement) {
          const now = new Date();
          const timeString = now.toLocaleTimeString('es-ES', { hour: 'numeric', minute: '2-digit', hour12: true });
          clockElement.textContent = `🕒 ${timeString}`;
        }
      }
      setInterval(updateClock, 1000);
      updateClock();

      // 2. Clima Open-Meteo
      async function obtenerClima() {
        try {
          const lat = 4.6097; const lon = -74.0817;
          const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true`);
          const data = await res.json();
          const temp = Math.round(data.current_weather.temperature);
          const code = data.current_weather.weathercode;
          let condicion = "Despejado", icono = "☀️";
          if (code >= 51 && code <= 67) { condicion = "Lluvioso"; icono = "🌧️"; }
          else if (code >= 71 && code <= 77) { condicion = "Nevando"; icono = "❄️"; }
          else if (code >= 95) { condicion = "Tormenta"; icono = "⚡"; }
          else if (code >= 1 && code <= 3) { condicion = "Nublado"; icono = "☁️"; }
          else if (code === 45 || code === 48) { condicion = "Neblina"; icono = "🌫️"; }
          const elClima = document.getElementById('widget-clima');
          if (elClima) elClima.textContent = `${icono} ${temp}°C ${condicion}`;
        } catch (e) {
          const elClima = document.getElementById('widget-clima');
          if (elClima) elClima.textContent = "⛅ Clima no disponible";
        }
      }
      obtenerClima();

      // 3. IP
      fetch('https://api.ipify.org?format=json')
        .then(response => response.json())
        .then(data => {
          const ipElement = document.getElementById('userIp');
          if (ipElement) ipElement.textContent = `🌐 IP: ${data.ip}`;
        })
        .catch(() => {
          const ipElement = document.getElementById('userIp');
          if (ipElement) ipElement.textContent = `🌐 IP: No disponible`;
        });

      // 4. Barra de Progreso de Lectura al hacer Scroll
      window.addEventListener('scroll', () => {
        const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        const progressBar = document.getElementById('readingProgress');
        if (progressBar) progressBar.style.width = scrolled + '%';
      });

      // 5. Reacciones con Cubitos 🧊 persistentes en localStorage
      const postSlug = window.location.pathname;
      const likeKey = `cubo_likes_${postSlug}`;
      let currentLikes = parseInt(localStorage.getItem(likeKey)) || 12;
      const likeCountEl = document.getElementById('likeCount');
      if (likeCountEl) likeCountEl.textContent = currentLikes;

      const likeBtn = document.getElementById('likeBtn');
      if (likeBtn) {
        likeBtn.addEventListener('click', () => {
          currentLikes++;
          localStorage.setItem(likeKey, currentLikes);
          if (likeCountEl) likeCountEl.textContent = currentLikes;
          likeBtn.style.transform = 'scale(1.1)';
          setTimeout(() => likeBtn.style.transform = 'scale(1)', 200);
        });
      }

      // 6. Botón Copiar Enlace
      const shareBtn = document.getElementById('shareBtn');
      const copyToast = document.getElementById('copyToast');
      if (shareBtn) {
        shareBtn.addEventListener('click', () => {
          navigator.clipboard.writeText(window.location.href);
          if (copyToast) {
            copyToast.style.display = 'block';
            setTimeout(() => copyToast.style.display = 'none', 3000);
          }
        });
      }

      // 7. Temas
      const themeButtons = document.querySelectorAll('.theme-btn');
      themeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          themeButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const targetTheme = btn.getAttribute('data-theme-target');
          if (targetTheme) {
            document.documentElement.setAttribute('data-theme', targetTheme);
            localStorage.setItem('cubo-theme', targetTheme);
          }
        });
      });

      const savedTheme = localStorage.getItem('cubo-theme');
      if (savedTheme) {
        document.documentElement.setAttribute('data-theme', savedTheme);
        themeButtons.forEach(b => {
          if (b.getAttribute('data-theme-target') === savedTheme) b.classList.add('active');
          else b.classList.remove('active');
        });
      }

      const searchInput = document.getElementById('searchInput');
      const searchInputBottom = document.getElementById('searchInputBottom');
      function redirectToHomeSearch(e) {
        if (e.key === 'Enter' && e.target.value.trim() !== '') {
          window.location.href = `/?q=${encodeURIComponent(e.target.value.trim())}`;
        }
      }
      if (searchInput) searchInput.addEventListener('keypress', redirectToHomeSearch);
      if (searchInputBottom) searchInputBottom.addEventListener('keypress', redirectToHomeSearch);
    </script>
  </body>
</html>

<style>
  :root[data-theme="dark"] {
    --bg-base: #000000;
    --bg-surface: #0b0f19;
    --bg-card: #141414;
    --border-color: #222222;
