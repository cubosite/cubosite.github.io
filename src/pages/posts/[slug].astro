    --border-color: #cbd5e1;
    --text-main: #0f172a;
    --text-muted: #475569;
    --accent: #0284c7;
    --accent-glow: rgba(2, 132, 199, 0.1);
  }

  :root[data-theme="green"] {
    --bg-base: #022c22;
    --bg-surface: #064e3b;
    --bg-card: #065f46;
    --border-color: #047857;
    --text-main: #ecfdf5;
    --text-muted: #a7f3d0;
    --accent: #34d399;
    --accent-glow: rgba(52, 211, 153, 0.15);
  }

  body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-base);
    color: var(--text-main);
    margin: 0;
    padding: 0;
    transition: background-color 0.3s ease, color 0.3s ease;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* Barra de Progreso de Lectura */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 4px;
    background-color: var(--accent);
    width: 0%;
    z-index: 1000;
    transition: width 0.1s ease-out;
  }

  .navbar {
    background-color: var(--bg-surface);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 1rem 2rem;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
