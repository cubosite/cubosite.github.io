    border-color: var(--accent);
    width: 230px;
    box-shadow: 0 0 10px var(--accent-glow);
  }

  .search-box input::placeholder {
    color: var(--text-muted);
  }

  .nav-links {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
