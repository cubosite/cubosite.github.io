---
// Configuración y metadatos de la página
const titulo = "Cubosite - Bitácora y Exploración Digital";
---

<html lang="es">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{titulo}</title>
	<style>
		:root {
			--bg-color: #0b0f19;
			--card-bg: rgba(255, 255, 255, 0.05);
			--text-color: #ffffff;
			--text-muted: #9ca3af;
			--accent: #3b82f6;
		}

		body {
			background-color: var(--bg-color);
			color: var(--text-color);
			font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
			margin: 0;
			padding: 2rem;
			display: flex;
			flex-direction: column;
			align-items: center;
			min-height: 100vh;
		}

		.header-container {
			display: flex;
			gap: 1rem;
			margin-bottom: 2rem;
			flex-wrap: wrap;
			justify-content: center;
		}

		.pill-nav {
			background: rgba(255, 255, 255, 0.08);
			border: 1px solid rgba(255, 255, 255, 0.1);
			padding: 0.5rem 1rem;
			border-radius: 9999px;
			display: flex;
			align-items: center;
			gap: 1rem;
			font-size: 0.875rem;
		}

		.badge-active {
			background: #3b82f6;
			color: white;
			padding: 0.25rem 0.75rem;
			border-radius: 9999px;
			font-weight: 500;
		}

		.main-title {
			font-size: 3rem;
			font-weight: 800;
			margin: 0.5rem 0;
			letter-spacing: -0.025em;
			text-align: center;
		}

		.subtitle {
			color: var(--text-muted);
			font-size: 1.1rem;
			text-align: center;
			max-width: 600px;
			margin-bottom: 3rem;
		}

		.categories-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
			gap: 1rem;
			width: 100%;
			max-width: 800px;
		}

		.category-card {
			background: var(--card-bg);
			border: 1px solid rgba(255, 255, 255, 0.08);
			padding: 1.5rem;
			border-radius: 1rem;
			text-align: center;
			text-decoration: none;
			color: white;
			font-weight: 600;
			transition: all 0.2s ease-in-out;
		}

		.category-card:hover {
			background: rgba(255, 255, 255, 0.12);
			transform: translateY(-3px);
			border-color: var(--accent);
		}
	</style>
</head>
<body>

	<!-- Barra superior de estados -->
	<div class="header-container">
		<div class="pill-nav">
			<span class="badge-active">🌙 Dark</span>
			<span>☀️ Gris Claro</span>
			<span>🟢 Green</span>
		</div>

		<div class="pill-nav">
			<span id="reloj">⏳ Cargando hora...</span>
			<span id="widget-clima">⛅ Cargando clima...</span>
			<span id="ip-user">🌐 IP: Buscando...</span>
		</div>
	</div>

	<!-- Títulos principales -->
	<h1 class="main-title">Bitácora y Exploración Digital</h1>
	<p class="subtitle">Un espacio propio para almacenar películas, videos, reflexiones y noticias sin depender de plataformas corporativas.</p>

	<!-- Categorías del sitio -->
	<div class="categories-grid">
		<a href="/" class="category-card">🏠 Inicio</a>
		<a href="/peliculas" class="category-card">🎬 Películas</a>
		<a href="/articulos" class="category-card">📝 Artículos</a>
		<a href="/noticias" class="category-card">📰 Noticias</a>
		<a href="/videos" class="category-card">🎥 Videos</a>
		<a href="/novedades" class="category-card">🚀 Novedades</a>
	</div>

	<!-- Script limpio optimizado para Astro -->
	<script is:inline>
		// 1. Reloj en tiempo real
		function actualizarReloj() {
			const ahora = new Date();
			const elReloj = document.getElementById('reloj');
			if (elReloj) {
				elReloj.innerText = '🕒 ' + ahora.toLocaleTimeString();
			}
		}
		setInterval(actualizarReloj, 1000);
		actualizarReloj();

		// 2. Obtener IP del usuario
		fetch('https://api.ipify.org?format=json')
			.then(function(response) { return response.json(); })
			.then(function(data) {
				const elIp = document.getElementById('ip-user');
				if (elIp) {
					elIp.innerText = '🌐 IP: ' + data.ip;
				}
			})
			.catch(function() {
				const elIp = document.getElementById('ip-user');
				if (elIp) {
					elIp.innerText = '🌐 IP: No disponible';
				}
			});

		// 3. Clima dinámico real
		async function obtenerClima() {
			try {
				const lat = 4.6097;
				const lon = -74.0817;
				const res = await fetch('https://api.open-meteo.com/v1/forecast?latitude=' + lat + '&longitude=' + lon + '&current_weather=true');
				const data = await res.json();
				
				const temp = Math.round(data.current_weather.temperature);
				const code = data.current_weather.weathercode;

				let condicion = "Despejado";
				let icono = "☀️";

				if (code >= 51 && code <= 67) {
					condicion = "Lluvioso";
					icono = "🌧️";
				} else if (code >= 71 && code <= 77) {
					condicion = "Nevando";
					icono = "❄️";
				} else if (code >= 95) {
					condicion = "Tormenta";
					icono = "⚡";
				} else if (code >= 1 && code <= 3) {
					condicion = "Nublado";
					icono = "☁️";
				} else if (code === 45 || code === 48) {
					condicion = "Neblina";
					icono = "🌫️";
				}

				const elClima = document.getElementById('widget-clima');
				if (elClima) {
					elClima.innerText = icono + ' ' + temp + '°C ' + condicion;
				}
			} catch (e) {
				const elClima = document.getElementById('widget-clima');
				if (elClima) {
					elClima.innerText = "⛅ Clima no disponible";
				}
			}
		}

		obtenerClima();
	</script>
</body>
</html>
