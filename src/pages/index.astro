---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  
  // Normalizar y extraer todas las categorías únicas en minúsculas y sin acentos raros
  const categories = [...new Set(posts.map(post => {
    const cat = post.data.category || 'general';
    return cat.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
  }))];

  return categories.map(categorySlug => {
    const filteredPosts = posts.filter(post => {
      const postCat = (post.data.category || 'general').normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
      return postCat === categorySlug;
    });
    
    filteredPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return {
      params: { category: categorySlug },
      props: { category: categorySlug, posts: filteredPosts },
    };
  });
}

const { category, posts } = Astro.props;
const titulo = `Categoría: ${category} | CUBOsite 🧊`;
---
