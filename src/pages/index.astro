---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const titulo = "Cubosite 🧊";
---

<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Estilos CSS Inline directos para asegurar que GitHub Pages los pinte sí o sí -->
    <style is:inline>
      :root {
        --bg-base: #000000;
        --bg-surface: #0b0f19;
        --bg-card: #141414;
        --border-color: #222222;
        --text-main: #ffffff;
        --text-muted: #a1a1aa;
        --accent: #aaff00;
        --accent-glow: rgba(170, 255, 0, 0.15);
      }

      html[data-theme="light"] {
        --bg-base: #f1f5f9;
        --bg-surface: #e2e8f0;
        --bg-card: #ffffff;
        --border-color: #cbd5e1;
        --text-main: #0f172a;
        --text-muted: #475569;
        --accent: #0284c7;
        --accent-glow: rgba(2, 132, 199, 0.1);
      }

      html[data-theme="green"] {
        --bg-base: #022c22;
        --bg-surface: #064e3b;
        --bg-card: #065f46;
        --border-color: #047857;
        --text-main: #ecfdf5;
        --text-muted: #a7f3d0;
        --accent: #34d399;
        --accent-glow: rgba(52, 211, 153, 0.15);
      }

      body {
        font-family: 'Inter', sans-serif;
        background-color: var(--bg-base);
        color: var(--text-main);
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      .reading-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 4px;
        background-color: var(--accent);
        width: 0%;
        z-index: 1000;
      }

      .navbar {
        background-color: var(--bg-surface);
        border-bottom: 1px solid var(--border-color);
        position: sticky;
        top: 0;
        z-index: 100;
        padding: 1rem 2rem;
      }

      .nav-container {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .logo {
        font-weight: 700;
        font-size: 1.25rem;
        color: var(--accent);
        text-decoration: none;
      }

      .search-box input {
        background-color: var(--bg-base);
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        font-size: 0.85rem;
        outline: none;
        width: 180px;
      }

      .search-box input:focus {
        border-color: var(--accent);
        width: 230px;
        box-shadow: 0 0 10px var(--accent-glow);
      }

      .nav-links {
        display: flex;
        gap: 1.2rem;
        flex-wrap: wrap;
        align-items: center;
      }

      .nav-links a {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
      }

      .nav-links a:hover, .nav-links a.active {
        color: var(--accent);
      }

      .container {
        max-width: 1150px;
        margin: 0 auto;
        padding: 4rem 2rem;
        flex: 1;
        width: 100%;
        box-sizing: border-box;
      }

      .hero {
        text-align: center;
        margin-bottom: 3rem;
      }

      .hero-top-bar {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1.25rem;
        margin-bottom: 1.75rem;
        flex-wrap: wrap;
      }

      .theme-switchers {
        display: flex;
        align-items: center;
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        padding: 0.3rem;
        border-radius: 9999px;
        gap: 0.25rem;
      }

      .theme-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        padding: 0.45rem 1rem;
        border-radius: 9999px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
      }

      .theme-btn.active, .theme-btn:hover {
        background-color: var(--accent);
        color: #000000;
      }

      .info-widget {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 0.45rem 1.25rem;
        border-radius: 9999px;
        font-size: 0.9rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .info-widget .divider {
        color: var(--border-color);
      }

      h1 {
        font-size: 2.5rem;
        margin: 1.2rem 0
