---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const titulo = "Cubosite 🧊";
---

<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Barra de Navegación -->
    <header class="navbar">
      <div class="nav-container">
        <a href="#" class="logo">Cubosite 🧊</a>
        
        <!-- Buscador integrado -->
        <div class="search-box">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="🔍 Buscar publicaciones..." 
            autocomplete="off"
          />
        </div>

        <!-- Filtros por categoría -->
        <nav class="nav-links">
          <a href="#" class="filter-btn active" data-category="todos">Inicio</a>
          <a href="#terror" class="filter-btn" data-category="Terror">Terror</a>
          <a href="#comedia" class="filter-btn" data-category="Comedia">Comedia</a>
          <a href="#ficcion" class="filter-btn" data-category="Ficcion">Ficción</a>
          <a href="#drama" class="filter-btn" data-category="Drama">Drama</a>
          <a href="#accion" class="filter-btn" data-category="Accion">Acción</a>
          <a href="#suspenso" class="filter-btn" data-category="Suspenso">Suspenso</a>
          <a href="#archivos" class="filter-btn" data-category="+Archivos">+Archivos</a>
        </nav>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="container">
      <section class="hero">
        <!-- Panel superior: Botones de tema + Widget de Hora e IP -->
        <div class="hero-top-bar">
          <div class="theme-switchers">
            <button class="theme-btn active" data-theme-target="dark">🌙 Dark</button>
            <button class="theme-btn" data-theme-target="light">☀️ Gris Claro</button>
            <button class="theme-btn" data-theme-target="green">🟢 Green</button>
          </div>
          
          <div class="info-widget">
            <span id="liveClock">🕒 Cargando hora...</span>
            <span class="divider">|</span>
            <span id="userIp">🌐 IP: Cargando...</span>
          </div>
        </div>

        <h1>Bitácora y Exploración Digital</h1>
        <p>Un espacio propio para almacenar películas, videos, reflexiones y noticias sin depender de plataformas corporativas.</p>
      </section>

      <!-- Secciones de Contenido Dinámico -->
      <section class="content-section">
        <h2>Últimas Publicaciones</h2>
        
        <div class="grid" id="cardsGrid">
          {posts.map((post) => (
            <a href={`/posts/${post.slug}`} class="card" data-title={post.data.title} data-category={post.data.category}>
              <span class="tag">{post.data.category}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="date">
                Publicado el {post.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
            </a>
          ))}
        </div>

        <!-- Mensaje si no hay resultados -->
        <p id="noResults" style="display: none; text-align: center; color: var(--text-muted); margin-top: 2rem;">
          No se encontraron publicaciones en esta categoría o búsqueda 🧊
        </p>
      </section>

      <footer>
        <p>Hecho con 🧊 y Astro por Cubo. Todos los derechos reservados.</p>
      </footer>
    </main>

    <!-- Script de filtrado, temas, reloj e IP -->
    <script>
      function updateClock() {
        const clockElement = document.getElementById('liveClock');
        if (clockElement) {
          const now = new Date();
          const timeString = now.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
          clockElement.textContent = `🕒 ${timeString}`;
        }
      }
      setInterval(updateClock, 1000);
      updateClock();

      fetch('https://api.ipify.org?format=json')
        .then(response => response.json())
        .then(data => {
          const ipElement = document.getElementById('userIp');
          if (ipElement) {
            ipElement.textContent = `🌐 IP: ${data.ip}`;
          }
        })
        .catch(() => {
          const ipElement = document.getElementById('userIp');
          if (ipElement) ipElement.textContent = `🌐 IP: No disponible`;
        });

      const themeButtons = document.querySelectorAll('.theme-btn');
      themeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          themeButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const targetTheme = btn.getAttribute('data-theme-target');
          if (targetTheme) {
            document.documentElement.setAttribute('data-theme', targetTheme);
            localStorage.setItem('cubo-theme', targetTheme);
          }
        });
      });

      const savedTheme = localStorage.getItem('cubo-theme');
      if (savedTheme) {
        document.documentElement.setAttribute('data-theme', savedTheme);
        themeButtons.forEach(b => {
          if (b.getAttribute('data-theme-target') === savedTheme) {
            b.classList.add('active');
          } else {
            b.classList.remove('active');
          }
        });
      }

      const searchInput = document.getElementById('searchInput') as HTMLInputElement;
      const cardsGrid = document.getElementById('cardsGrid');
      const cards = cardsGrid ? Array.from(cardsGrid.getElementsByClassName('card')) : [];
      const filterButtons = document.querySelectorAll('.filter-btn');
      const noResults = document.getElementById('noResults');

      let currentCategory = 'todos';

      function normalizeText(text: string) {
        return text ? text.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim() : "";
      }

      filterButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          filterButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentCategory = btn.getAttribute('data-category') || 'todos';
          filterCards();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', () => {
          filterCards();
        });
      }

      function filterCards() {
        const searchTerm = searchInput ? normalizeText(searchInput.value) : '';
        let visibleCount = 0;

        cards.forEach(card => {
          const title = normalizeText(card.getAttribute('data-title'));
          const category = normalizeText(card.getAttribute('data-category'));
          const text = normalizeText(card.textContent);

          const normCurrentCat = normalizeText(currentCategory);
          const matchesCategory = (currentCategory === 'todos' || category === normCurrentCat);
          const matchesSearch = (title.includes(searchTerm) || category.includes(searchTerm) || text.includes(searchTerm));

          if (matchesCategory && matchesSearch) {
            (card as HTMLElement).style.display = 'block';
            visibleCount++;
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.style.display = 'block';
          } else {
            noResults.style.display = 'none';
          }
        }
      }
    </script>
  </body>
</html>

<style>
  :root[data-theme="dark"] {
    --bg-base: #030712;
    --bg-surface: #0b0f19;
    --bg-card: #111827;
    --border-color: #1e293b;
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --accent: #38bdf8;
    --accent-glow: rgba(56, 189, 248, 0.1);
  }

  :root[data-theme="light"] {
    --bg-base: #f1f5f9;
    --bg-surface: #e2e8f0;
    --bg-card: #ffffff;
    --border-color: #cbd5e1;
    --text-main: #0f172a;
    --text-muted: #475569;
    --accent: #0284c7;
    --accent-glow: rgba(2, 132, 199, 0.1);
  }

  :root[data-theme="green"] {
    --bg-base: #022c22;
    --bg-surface: #064e3b;
    --bg-card: #065f46;
    --border-color: #047857;
    --text-main: #ecfdf5;
    --text-muted: #a7f3d0;
    --accent: #34d399;
    --accent-glow: rgba(52, 211, 153, 0.15);
  }

  body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-base);
    color: var(--text-main);
    margin: 0;
    padding: 0;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .navbar {
    background-color: var(--bg-surface);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 1rem 2rem;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .logo {
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--text-main);
    text-decoration: none;
  }

  .search-box input {
    background-color: var(--bg-base);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    outline: none;
    width: 180px;
    transition: all 0.2s ease;
  }

  .search-box input:focus {
    border-color: var(--accent);
    width: 230px;
    box-shadow: 0 0 10px var(--accent-glow);
  }

  .search-box input::placeholder {
    color: var(--text-muted);
  }

  .nav-links {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 0.2s ease;
    cursor: pointer;
  }

  .nav-links a:hover, .nav-links a.active {
    color: var(--accent);
  }

  .container {
    max-width: 1150px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .hero {
    text-align: center;
    margin-bottom: 3rem;
  }

  .hero-top-bar {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .theme-switchers {
    display: flex;
    align-items: center;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 0.3rem;
    border-radius: 9999px;
    gap: 0.25rem;
  }

  .theme-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .theme-btn.active, .theme-btn:hover {
    background-color: var(--accent);
    color: var(--bg-base);
  }

  .info-widget {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    padding: 0.45rem 1.25rem;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .info-widget .divider {
    color: var(--border-color);
    font-weight: 400;
  }

  h1 {
    font-size: 2.5rem;
    margin: 1.2rem 0 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .hero p {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .content-section {
    margin-bottom: 4rem;
  }

  .content-section h2 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .card {
    display: block;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 1.5rem;
    border-radius: 0.75rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, border-color 0.2s ease;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }

  .card:hover h3 {
    color: var(--accent);
  }

  .tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    font-weight: 700;
    background-color: var(--accent-glow);
    padding: 0.25rem 0.6rem;
    border-radius: 9999px
