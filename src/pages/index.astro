---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
posts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// Calcular estadísticas automáticas de la bitácora
const totalPosts = posts.length;
const totalWords = posts.reduce((acc, post) => acc + (post.body ? post.body.split(/\s+/g).length : 500), 0);
const totalReadingMinutes = Math.ceil(totalWords / 200);
const buildDateStr = new Date().toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });

const titulo = "Cubosite 🧊";
---

<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🧊</text></svg>">
  </head>
  <body>
    <!-- Barra de Navegación -->
    <header class="navbar">
      <div class="nav-container">
        <a href="/" class="logo">Cubosite 🧊</a>
        
        <!-- Buscador integrado -->
        <div class="search-box">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="🔍 Buscar (Ctrl+K)..." 
            autocomplete="off"
          />
        </div>

        <!-- Filtros por categoría -->
        <nav class="nav-links">
          <a href="/" class="active">Inicio</a>
          <a href="/category/terror">Terror</a>
          <a href="/category/comedia">Comedia</a>
          <a href="/category/ficcion">Ficción</a>
          <a href="/category/drama">Drama</a>
          <a href="/category/accion">Acción</a>
          <a href="/category/suspenso">Suspenso</a>
          <a href="/category/+archivos">+Archivos</a>
        </nav>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="container">
      <section class="hero">
        <div class="hero-top-bar">
          <div class="theme-switchers">
            <button class="theme-btn active" data-theme-target="dark">🌙 Dark</button>
            <button class="theme-btn" data-theme-target="light">☀️ Gris Claro</button>
            <button class="theme-btn" data-theme-target="green">🟢 Green</button>
          </div>
          
          <div class="info-widget">
            <span id="liveClock">🕒 Cargando...</span>
            <span class="divider">|</span>
            <span id="widget-clima">⛅ Cargando...</span>
            <span class="divider">|</span>
            <span id="userIp">🌐 IP: Cargando...</span>
          </div>
        </div>

        <h1>Bitácora y Exploración Digital</h1>
        <p>Un espacio propio para almacenar películas, videos, reflexiones y noticias sin depender de plataformas corporativas.</p>
      </section>

      <!-- Secciones de Contenido Dinámico -->
      <section class="content-section" id="postsSection">
        <h2>Últimas Publicaciones</h2>
        
        <div class="grid" id="cardsGrid">
          {posts.map((post) => (
            <a href={`/posts/${post.slug || post.id}`} class="card" data-title={post.data.title} data-category={post.data.category}>
              <span class="tag">{post.data.category}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="date">
                Publicado el {new Date(post.data.date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
              </span>
            </a>
          ))}
        </div>

        <!-- Controles de Paginación (24 artículos por página) -->
        <div class="pagination-container" id="paginationControls">
          <button id="prevPageBtn" class="page-btn">← Anterior</button>
          <span id="pageIndicator" class="page-info">Página 1 de 1</span>
          <button id="nextPageBtn" class="page-btn">Siguiente →</button>
        </div>

        <!-- Mensaje si no hay resultados -->
        <p id="noResults" style="display: none; text-align: center; color: var(--text-muted); margin-top: 2rem;">
          No se encontraron publicaciones en esta categoría o búsqueda 🧊
        </p>
      </section>
    </main>

    <!-- Footer Avanzado con Estadísticas de Bitácora -->
    <footer class="footer-advanced">
      <div class="footer-container">
        <div class="footer-col">
          <h3>Cubosite 🧊</h3>
          <p>Plataforma web multitema construida con Astro SSG y desplegada de forma independiente. Contenido autogestionado por Cubo.</p>
          <span class="footer-badge">Estado: 100% Operativo 🚀</span>
        </div>

        <div class="footer-col">
          <h4>📊 Métricas de Bitácora</h4>
          <ul class="stats-list">
            <li>📌 Artículos totales: <strong>{totalPosts}</strong></li>
            <li>⏱️ Tiempo de lectura global: <strong>~{totalReadingMinutes} mins</strong></li>
            <li>🔄 Última compilación: <strong>{buildDateStr}</strong></li>
            <li>⌨️ Tip: Presiona <code style="color:var(--accent);">Ctrl + K</code> para comandos</li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Actualizaciones & Búsqueda</h4>
          <p class="update-info">Versión: <strong>v4.1 Paginated + Palette</strong></p>
          
          <div class="footer-search-box">
            <input 
              type="text" 
              id="searchInputBottom" 
              placeholder="🔍 Búsqueda rápida..." 
              autocomplete="off"
            />
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p>Hecho con 🧊 y Astro por CuBo. Todos los derechos reservados.</p>
      </div>
    </footer>

    <!-- Modal de Paleta de Comandos (Ctrl + K) -->
    <div id="commandPalette" class="command-palette-backdrop">
      <div class="command-palette-modal">
        <input type="text" id="paletteInput" class="command-palette-input" placeholder="Escribe un comando o busca una sección..." autocomplete="off">
        <ul id="paletteList" class="command-palette-list">
          <li class="command-palette-item" data-action="home">🏠 Ir al Inicio <span>Ctrl+H</span></li>
          <li class="command-palette-item" data-action="terror">👻 Categoría: Terror <span>Ctrl+1</span></li>
          <li class="command-palette-item" data-action="comedia">😂 Categoría: Comedia <span>Ctrl+2</span></li>
          <li class="command-palette-item" data-action="ficcion">🚀 Categoría: Ficción <span>Ctrl+3</span></li>
          <li class="command-palette-item" data-action="theme-dark">🌙 Cambiar a Tema Dark <span>Ctrl+D</span></li>
          <li class="command-palette-item" data-action="theme-light">☀️ Cambiar a Tema Gris Claro <span>Ctrl+L</span></li>
          <li class="command-palette-item" data-action="theme-green">🟢 Cambiar a Tema Green <span>Ctrl+G</span></li>
          <li class="command-palette-item" data-action="github">🐙 Abrir Repositorio GitHub <span>Link</span></li>
        </ul>
      </div>
    </div>

    <!-- Script de Reloj, Clima, Temas, Búsqueda, Paginación (24/pág) y Paleta de Comandos -->
    <script is:inline>
      function updateClock() {
        const clockElement = document.getElementById('liveClock');
        if (clockElement) {
          const now = new Date();
          const timeString = now.toLocaleTimeString('es-ES', { hour: 'numeric', minute: '2-digit', hour12: true });
          clockElement.textContent = `🕒 ${timeString}`;
        }
      }
      setInterval(updateClock, 1000);
      updateClock();

      async function obtenerClima() {
        try {
          const lat = 4.6097; const lon = -74.0817;
          const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true`);
          const data = await res.json();
          const temp = Math.round(data.current_weather.temperature);
          const code = data.current_weather.weathercode;
          let condicion = "Despejado", icono = "☀️";
          if (code >= 51 && code <= 67) { condicion = "Lluvioso"; icono = "🌧️"; }
          else if (code >= 71 && code <= 77) { condicion = "Nevando"; icono = "❄️"; }
          else if (code >= 95) { condicion = "Tormenta"; icono = "⚡"; }
          else if (code >= 1 && code <= 3) { condicion = "Nublado"; icono = "☁️"; }
          else if (code === 45 || code === 48) { condicion = "Neblina"; icono = "🌫️"; }
          const elClima = document.getElementById('widget-clima');
          if (elClima) elClima.textContent = `${icono} ${temp}°C ${condicion}`;
        } catch (e) {
          const elClima = document.getElementById('widget-clima');
          if (elClima) elClima.textContent = "⛅ Clima no disponible";
        }
      }
      obtenerClima();

      fetch('https://api.ipify.org?format=json')
        .then(response => response.json())
        .then(data => {
          const ipElement = document.getElementById('userIp');
          if (ipElement) ipElement.textContent = `🌐 IP: ${data.ip}`;
        })
        .catch(() => {
          const ipElement = document.getElementById('userIp');
          if (ipElement) ipElement.textContent = `🌐 IP: No disponible`;
        });

      const themeButtons = document.querySelectorAll('.theme-btn');
      themeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          themeButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const targetTheme = btn.getAttribute('data-theme-target');
          if (targetTheme) {
            document.documentElement.setAttribute('data-theme', targetTheme);
            localStorage.setItem('cubo-theme', targetTheme);
          }
        });
      });

      const savedTheme = localStorage.getItem('cubo-theme');
      if (savedTheme) {
        document.documentElement.setAttribute('data-theme', savedTheme);
        themeButtons.forEach(b => {
          if (b.getAttribute('data-theme-target') === savedTheme) b.classList.add('active');
          else b.classList.remove('active');
        });
      }

      // --- LÓGICA DE PAGINACIÓN (24 ARTÍCULOS POR PÁGINA) Y BÚSQUEDA ---
      const ITEMS_PER_PAGE = 24;
      let currentPage = 1;
      let currentSearchTerm = '';

      const searchInput = document.getElementById('searchInput');
      const searchInputBottom = document.getElementById('searchInputBottom');
      const cardsGrid = document.getElementById('cardsGrid');
      const allCards = cardsGrid ? Array.from(cardsGrid.getElementsByClassName('card')) : [];
      const noResults = document.getElementById('noResults');
      const paginationControls = document.getElementById('paginationControls');
      const prevPageBtn = document.getElementById('prevPageBtn');
      const nextPageBtn = document.getElementById('nextPageBtn');
      const pageIndicator = document.getElementById('pageIndicator');
      const postsSection = document.getElementById('postsSection');

      function renderPosts() {
        const term = currentSearchTerm.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
        
        // Filtrar tarjetas que coinciden con la búsqueda
        const matchingCards = allCards.filter(card => {
          const text = card.textContent.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
          return text.includes(term);
        });

        const totalPages = Math.max(1, Math.ceil(matchingCards.length / ITEMS_PER_PAGE));
        if (currentPage > totalPages) currentPage = totalPages;

        const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
        const endIndex = startIndex + ITEMS_PER_PAGE;

        // Ocultar todas las tarjetas primero
        allCards.forEach(card => card.style.display = 'none');

        // Mostrar únicamente las 24 de la página actual
        matchingCards.slice(startIndex, endIndex).forEach(card => {
          card.style.display = 'block';
        });

        // Mostrar mensaje si no hay coincidencias
        if (noResults) {
          noResults.style.display = matchingCards.length === 0 ? 'block' : 'none';
        }

        // Actualizar controles de paginación
        if (paginationControls) {
          if (matchingCards.length <= ITEMS_PER_PAGE) {
            paginationControls.style.display = 'none';
          } else {
            paginationControls.style.display = 'flex';
            if (pageIndicator) pageIndicator.textContent = `Página ${currentPage} de ${totalPages}`;
            if (prevPageBtn) {
              prevPageBtn.disabled = currentPage === 1;
              prevPageBtn.style.opacity = currentPage === 1 ? '0.4' : '1';
              prevPageBtn.style.cursor = currentPage === 1 ? 'not-allowed' : 'pointer';
            }
            if (nextPageBtn) {
              nextPageBtn.disabled = currentPage === totalPages;
              nextPageBtn.style.opacity = currentPage === totalPages ? '0.4' : '1';
              nextPageBtn.style.cursor = currentPage === totalPages ? 'not-allowed' : 'pointer';
            }
          }
        }
      }

      if (prevPageBtn) {
        prevPageBtn.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            renderPosts();
            if (postsSection) postsSection.scrollIntoView({ behavior: 'smooth' });
          }
        });
      }

      if (nextPageBtn) {
        nextPageBtn.addEventListener('click', () => {
          const term = currentSearchTerm.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
          const matchingCount = allCards.filter(c => c.textContent.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().includes(term)).length;
          const totalPages = Math.ceil(matchingCount / ITEMS_PER_PAGE);
          if (currentPage < totalPages) {
            currentPage++;
            renderPosts();
            if (postsSection) postsSection.scrollIntoView({ behavior: 'smooth' });
          }
        });
      }

      function handleSearch(query) {
        currentSearchTerm = query;
        currentPage = 1;
        renderPosts();
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          if (searchInputBottom) searchInputBottom.value = e.target.value;
          handleSearch(e.target.value);
        });
      }
      if (searchInputBottom) {
        searchInputBottom.addEventListener('input', (e) => {
          if (searchInput) searchInput.value = e.target.value;
          handleSearch(e.target.value);
        });
      }

      // Leer parámetro ?q= si el usuario viene buscando desde un post
      const urlParams = new URLSearchParams(window.location.search);
      const initialQuery = urlParams.get('q');
      if (initialQuery) {
        if (searchInput) searchInput.value = initialQuery;
        if (searchInputBottom) searchInputBottom.value = initialQuery;
