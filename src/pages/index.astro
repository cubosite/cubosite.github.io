---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const titulo = "Cubosite 🧊";
---

<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Barra de Navegación -->
    <header class="navbar">
      <div class="nav-container">
        <a href="#" class="logo">Cubosite 🧊</a>
        
        <!-- Buscador superior -->
        <div class="search-box">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="🔍 Buscar publicaciones..." 
            autocomplete="off"
          />
        </div>

        <!-- Filtros por categoría -->
        <nav class="nav-links">
          <a href="#" class="filter-btn active" data-category="todos">Inicio</a>
          <a href="#terror" class="filter-btn" data-category="Terror">Terror</a>
          <a href="#comedia" class="filter-btn" data-category="Comedia">Comedia</a>
          <a href="#ficcion" class="filter-btn" data-category="Ficcion">Ficción</a>
          <a href="#drama" class="filter-btn" data-category="Drama">Drama</a>
          <a href="#accion" class="filter-btn" data-category="Accion">Acción</a>
          <a href="#suspenso" class="filter-btn" data-category="Suspenso">Suspenso</a>
          <a href="#archivos" class="filter-btn" data-category="+Archivos">+Archivos</a>
        </nav>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="container">
      <section class="hero">
        <div class="hero-top-bar">
          <div class="theme-switchers">
            <button class="theme-btn active" data-theme-target="dark">🌙 Dark</button>
            <button class="theme-btn" data-theme-target="light">☀️ Gris Claro</button>
            <button class="theme-btn" data-theme-target="green">🟢 Green</button>
          </div>
          
          <div class="info-widget">
            <span id="liveClock">🕒 Cargando hora...</span>
            <span class="divider">|</span>
            <span id="userIp">🌐 IP: Cargando...</span>
          </div>
        </div>

        <h1>Bitácora y Exploración Digital</h1>
        <p>Un espacio propio para almacenar películas, videos, reflexiones y noticias sin depender de plataformas corporativas.</p>
      </section>

      <!-- Secciones de Contenido Dinámico -->
      <section class="content-section">
        <h2>Últimas Publicaciones</h2>
        
        <div class="grid" id="cardsGrid">
          {posts.map((post) => (
            <a href={`/posts/${post.slug}`} class="card" data-title={post.data.title} data-category={post.data.category}>
              <span class="tag">{post.data.category}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="date">
                Publicado el {post.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
            </a>
          ))}
        </div>

        <!-- Mensaje si no hay resultados -->
        <p id="noResults" style="display: none; text-align: center; color: var(--text-muted); margin-top: 2rem;">
          No se encontraron publicaciones en esta categoría o búsqueda 🧊
        </p>
      </section>
    </main>

    <!-- Footer Avanzado en 3 Columnas + Buscador Inferior -->
    <footer class="footer-advanced">
      <div class="footer-container">
        
        <!-- Columna 1: Créditos y Descripción -->
        <div class="footer-col">
          <h3>Cubosite 🧊</h3>
          <p>Plataforma web multitema construida con Astro SSG y desplegada de forma independiente. Contenido autogestionado por Cubo.</p>
          <span class="footer-badge">Estado: 100% Operativo 🚀</span>
        </div>

        <!-- Columna 2: Enlaces Rápidos y Contacto -->
        <div class="footer-col">
          <h4>Contacto & Enlaces</h4>
          <ul>
            <li><a href="#">📩 Soporte / Reportar Error</a></li>
            <li><a href="https://github.com" target="_blank">🐙 Repositorio GitHub</a></li>
            <li><a href="#">💡 Sugerir Contenido</a></li>
            <li><a href="#">📜 Manual SKILL.md</a></li>
          </ul>
        </div>

        <!-- Columna 3: Actualizaciones y Buscador Inferior -->
        <div class="footer-col">
          <h4>Actualizaciones & Búsqueda</h4>
          <p class="update-info">Última versión: <strong>v3.5 Multitema</strong> (Nov 2026)</p>
          
          <!-- Barra de búsqueda inferior añadida -->
          <div class="footer-search-box">
            <input 
              type="text" 
              id="searchInputBottom" 
              placeholder="🔍 Búsqueda rápida abajo..." 
              autocomplete="off"
            />
          </div>
        </div>

      </div>

      <!-- Créditos finales de autoría -->
      <div class="footer-bottom">
        <p>Hecho con 🧊 y Astro por Cubo. Todos los derechos reservados.</p>
      </div>
    </footer>

    <!-- Script de filtrado sincronizado (arriba y abajo), temas, reloj e IP -->
    <script>
      function updateClock() {
        const clockElement = document.getElementById('liveClock');
        if (clockElement) {
          const now = new Date();
          const timeString = now.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
          clockElement.textContent = `🕒 ${timeString}`;
        }
      }
      setInterval(updateClock, 1000);
      updateClock();

      fetch('https://api.ipify.org?format=json')
        .then(response => response.json())
        .then(data => {
          const ipElement = document.getElementById('userIp');
          if (ipElement) {
            ipElement.textContent = `🌐 IP: ${data.ip}`;
          }
        })
        .catch(() => {
          const ipElement = document.getElementById('userIp');
          if (ipElement) ipElement.textContent = `🌐 IP: No disponible`;
        });

      const themeButtons = document.querySelectorAll('.theme-btn');
      themeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          themeButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const targetTheme = btn.getAttribute('data-theme-target');
          if (targetTheme) {
            document.documentElement.setAttribute('data-theme', targetTheme);
            localStorage.setItem('cubo-theme', targetTheme);
          }
        });
      });

      const savedTheme = localStorage.getItem('cubo-theme');
      if (savedTheme) {
        document.documentElement.setAttribute('data-theme', savedTheme);
        themeButtons.forEach(b => {
          if (b.getAttribute('data-theme-target') === savedTheme) {
            b.classList.add('active');
          } else {
            b.classList.remove('active');
          }
        });
      }

      // Sincronización de buscadores (arriba y abajo)
      const searchInput = document.getElementById('searchInput') as HTMLInputElement;
      const searchInputBottom = document.getElementById('searchInputBottom') as HTMLInputElement;
      const cardsGrid = document.getElementById('cardsGrid');
      const cards = cardsGrid ? Array.from(cardsGrid.getElementsByClassName('card')) : [];
      const filterButtons = document.querySelectorAll('.filter-btn');
      const noResults = document.getElementById('noResults');

      let currentCategory = 'todos';

      function normalizeText(text: string) {
        return text ? text.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim() : "";
      }

      filterButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          filterButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentCategory = btn.getAttribute('data-category') || 'todos';
          filterCards(searchInput ? searchInput.value : '');
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', () => {
          if (searchInputBottom) searchInputBottom.value = searchInput.value;
          filterCards(searchInput.value);
        });
      }

      if (searchInputBottom) {
        searchInputBottom.addEventListener('input', () => {
          if (searchInput) searchInput.value = searchInputBottom.value;
          filterCards(searchInputBottom.value);
        });
      }

      function filterCards(termValue: string) {
        const searchTerm = normalizeText(termValue);
        let visibleCount = 0;

        cards.forEach(card => {
          const title = normalizeText(card.getAttribute('data-title'));
          const category = normalizeText(card.getAttribute('data-category'));
          const text = normalizeText(card.textContent);

          const normCurrentCat = normalizeText(currentCategory);
          const matchesCategory
