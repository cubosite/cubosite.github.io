---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  
  // Extraer todas las categorías únicas de los posts
  const categories = [...new Set(posts.map(post => post.data.category))];

  return categories.map(category => {
    const filteredPosts = posts.filter(post => post.data.category === category);
    filteredPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return {
      params: { category: category.toLowerCase() },
      props: { category, posts: filteredPosts },
    };
  });
}

const { category, posts } = Astro.props;
const titulo = `Categoría: ${category} - Cubosite 🧊`;
---

<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Barra de Progreso de Lectura -->
    <div id="readingProgress" class="reading-progress"></div>

    <!-- Barra de Navegación -->
    <header class="navbar">
      <div class="nav-container">
        <a href="/" class="logo">Cubosite 🧊</a>
        
        <!-- Buscador integrado -->
        <div class="search-box">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="🔍 Buscar publicaciones..." 
            autocomplete="off"
          />
        </div>

        <!-- Filtros por categoría -->
        <nav class="nav-links">
          <a href="/">Inicio</a>
          <a href="/category/terror" class={category.toLowerCase() === 'terror' ? 'active' : ''}>Terror</a>
          <a href="/category/comedia" class={category.toLowerCase() === 'comedia' ? 'active' : ''}>Comedia</a>
          <a href="/category/ficcion" class={category.toLowerCase() === 'ficcion' ? 'active' : ''}>Ficción</a>
          <a href="/category/drama" class={category.toLowerCase() === 'drama' ? 'active' : ''}>Drama</a>
          <a href="/category/accion" class={category.toLowerCase() === 'accion' ? 'active' : ''}>Acción</a>
          <a href="/category/suspenso" class={category.toLowerCase() === 'suspenso' ? 'active' : ''}>Suspenso</a>
          <a href="/category/+archivos" class={category.toLowerCase() === '+archivos' ? 'active' : ''}>+Archivos</a>
        </nav>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="container">
      <section class="hero">
        <div class="hero-top-bar">
          <div class="theme-switchers">
            <button class="theme-btn active" data-theme-target="dark">🌙 Dark</button>
            <button class="theme-btn" data-theme-target="light">☀️ Gris Claro</button>
            <button class="theme-btn" data-theme-target="green">🟢 Green</button>
          </div>
          
          <div class="info-widget">
            <span id="liveClock">🕒 Cargando...</span>
            <span class="divider">|</span>
            <span id="widget-clima">⛅ Cargando...</span>
            <span class="divider">|</span>
            <span id="userIp">🌐 IP: Cargando...</span>
          </div>
        </div>

        <h1>Categoría: {category}</h1>
        <p>Explorando publicaciones filtradas bajo esta temática en tu bitácora digital independiente.</p>
      </section>

      <!-- Secciones de Contenido Dinámico -->
      <section class="content-section">
        <h2>Publicaciones en {category}</h2>
        
        <div class="grid" id="cardsGrid">
          {posts.map((post) => (
            <a href={`/posts/${post.slug || post.id}`} class="card" data-title={post.data.title} data-category={post.data.category}>
              <span class="tag">{post.data.category}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="date">
                Publicado el {post.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
            </a>
          ))}
        </div>

        <!-- Mensaje si no hay resultados -->
        <p id="noResults" style="display: none; text-align: center; color: var(--text-muted); margin-top: 2rem;">
          No se encontraron publicaciones con ese término de búsqueda 🧊
        </p>

        <div style="margin-top: 3rem; text-align: center;">
          <a href="/" class="page-btn" style="text-decoration: none; display: inline-block;">← Volver al Inicio</a>
        </div>
      </section>
    </main>

    <!-- Footer Avanzado -->
    <footer class="footer-advanced">
      <div class="footer-container">
        <div class="footer-col">
          <h3>Cubosite 🧊</h3>
          <p>Plataforma web multitema construida con Astro SSG y desplegada de forma independiente. Contenido autogestionado por Cubo.</p>
          <span class="footer-badge">Estado: 100% Operativo 🚀</span>
        </div>

        <div class="footer-col">
          <h4>Contacto & Enlaces</h4>
          <ul>
            <li><a href="/">📩 Soporte / Reportar Error</a></li>
            <li><a href="https://github.com" target="_blank">🐙 Repositorio GitHub</a></li>
            <li><a href="/">💡 Sugerir Contenido</a></li>
            <li><a href="/">📜 Manual SKILL.md</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Actualizaciones & Búsqueda</h4>
          <p class="update-info">Versión: <strong>v4.0 Categories</strong></p>
          
          <div class="footer-search-box">
            <input 
              type="text" 
              id="searchInputBottom" 
              placeholder="🔍 Búsqueda rápida abajo..." 
              autocomplete="off"
            />
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p>Hecho con 🧊 y Astro por Cubo. Todos los derechos reservados.</p>
      </div>
    </footer>

    <!-- Script de Funcionalidades -->
    <script is:inline>
      function updateClock() {
        const clockElement = document.getElementById('liveClock');
        if (clockElement) {
          const now = new Date();
          const timeString = now.toLocaleTimeString('es-ES', { hour: 'numeric', minute: '2-digit', hour12: true });
          clockElement.textContent = `🕒 ${timeString}`;
        }
      }
      setInterval(updateClock, 1000);
      updateClock();

      async function obtenerClima() {
        try {
          const lat = 4.6097; const lon = -74.0817;
          const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true`);
          const data = await res.json();
          const temp = Math.round(data.current_weather.temperature);
          const code = data.current_weather.weathercode;
          let condicion = "Despejado", icono = "☀️";
          if (code >= 51 && code <= 67) { condicion = "Lluvioso"; icono = "🌧️"; }
          else if (code >= 71 && code <= 77) { condicion = "Nevando"; icono = "❄️"; }
          else if (code >= 95) { condicion = "Tormenta"; icono = "⚡"; }
          else if (code >= 1 && code <= 3) { condicion = "Nublado"; icono = "☁️"; }
          else if (code === 45 || code === 48) { condicion = "Neblina"; icono = "🌫️"; }
          const elClima = document.getElementById('widget-clima');
          if (elClima) elClima.textContent = `${icono} ${temp}°C ${condicion}`;
        } catch (e) {
          const elClima = document.getElementById('widget-clima');
          if (elClima) elClima.textContent = "⛅ Clima no disponible";
        }
      }
      obtenerClima();

      fetch('https://api.ipify.org?format=json')
        .then(response => response.json())
        .then(data => {
          const ipElement = document.getElementById('userIp');
          if (ipElement) ipElement.textContent = `🌐 IP: ${data.ip}`;
        })
        .catch(() => {
          const ipElement = document.getElementById('userIp');
          if (ipElement) ipElement.textContent = `🌐 IP: No disponible`;
        });

      window.addEventListener('scroll', () => {
        const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        const progressBar = document.getElementById('readingProgress');
        if (progressBar) progressBar.style.width = scrolled + '%';
      });

      const themeButtons = document.querySelectorAll('.theme-btn');
      themeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          themeButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const targetTheme = btn.getAttribute('data-theme-target');
          if (targetTheme) {
            document.documentElement.setAttribute('data-theme', targetTheme);
            localStorage.setItem('cubo-theme', targetTheme);
          }
        });
      });

      const savedTheme = localStorage.getItem('cubo-theme');
      if (savedTheme) {
        document.documentElement.setAttribute('data-theme', savedTheme);
        themeButtons.forEach(b => {
          if (b.getAttribute('data-theme-target') === savedTheme) b.classList.add('active');
          else b.classList.remove('active');
        });
      }

      // Búsqueda en vivo dentro de la categoría actual
      const searchInput = document.getElementById('searchInput');
      const searchInputBottom = document.getElementById('searchInputBottom');
      const cardsGrid = document.getElementById('cardsGrid');
      const cards = cardsGrid ? Array.from(cardsGrid.getElementsByClassName('card')) : [];
      const noResults = document.getElementById('noResults');

      function filterCategoryCards(query) {
        const term = query.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
        let visibleCount = 0;
        cards.forEach(card => {
          const text = card.textContent.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
          if (text.includes(term)) {
            card.style.display = 'block';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });
        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          if (searchInputBottom) searchInputBottom.value = e.target.value;
          filterCategoryCards(e.target.value);
        });
      }
      if (searchInputBottom) {
        searchInputBottom.addEventListener('input', (e) => {
          if (searchInput) searchInput.value = e.target.value;
          filterCategoryCards(e.target.value);
        });
      }
    </script>
  </body>
</html>

<style>
  :root[data-theme="dark"] {
    --bg-base: #000000;
    --bg-surface: #0b0f19;
    --bg-card: #141414;
    --border-color: #222222;
    --text-main: #ffffff;
    --text-muted: #a1a1aa;
    --accent: #aaff00;
    --accent-glow: rgba(170, 255, 0, 0.15);
  }

  :root[data-theme="light"] {
    --bg-base: #f1f5f9;
    --bg-surface: #e2e8f0;
    --bg-card: #ffffff;
    --border-color: #cbd5e1;
    --text-main: #0f172a;
    --text-muted: #475569;
    --accent: #0284c7;
    --accent-glow: rgba(2, 132, 199, 0.1);
  }

  :root[data-theme="green"] {
    --bg-base: #022c22;
    --bg-surface: #064e3b;
    --bg-card: #065f46;
    --border-color: #047857;
    --text-main: #ecfdf5;
    --text-muted: #a7f3d0;
    --accent: #34d399;
    --accent-glow: rgba(52, 211, 153, 0.15);
  }

  body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-base);
    color: var(--text-main);
    margin: 0;
    padding: 0;
    transition: background-color 0.3s ease, color 0.3s ease;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 4px;
    background-color: var(--accent);
    width: 0%;
    z-index: 1000;
    transition: width 0.1s ease-out;
  }

  .navbar {
    background-color: var(--bg-surface);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 1rem 2rem;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .logo {
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--accent);
    text-decoration: none;
  }

  .search-box input {
    background-color: var(--bg-base);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    outline: none;
    width: 180px;
    transition: all 0.2s ease;
  }

  .search-box input:focus {
    border-color: var(--accent);
    width: 230px;
    box-shadow: 0 0 10px var(--accent-glow);
  }

  .search-box input::placeholder {
    color: var(--text-muted);
  }

  .nav-links {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: color 0.2s ease;
    cursor: pointer;
  }

  .nav-links a:hover, .nav-links a.active {
    color: var(--accent);
  }

  .container {
    max-width: 1150px;
    margin: 0 auto;
    padding: 4rem 2rem;
    flex: 1;
    width: 100%;
    box-sizing: border-box;
  }

  .hero {
    text-align: center;
    margin-bottom: 3rem;
  }

  .hero-top-bar {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .theme-switchers {
    display: flex;
    align-items: center;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 0.3rem;
    border-radius: 9999px;
    gap: 0.25rem;
  }

  .theme-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .theme-btn.active, .theme-btn:hover {
    background-color: var(--accent);
    color: #000000;
  }

  .info-widget {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    padding: 0.45rem 1.25rem;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .info-widget .divider {
    color: var(--border-color);
    font-weight: 400;
  }

  h1 {
    font-size: 2.5rem;
    margin: 1.2rem 0 1rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.02em;
  }

  .hero p {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .content-section {
    margin-bottom: 2rem;
  }

  .content-section h2 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
    color: var(--accent);
    font-weight: 700;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    justify-content: center;
    justify-items: center;
  }

  .card {
    display: block;
    width: 100%;
    max-width: 280px;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 1.5rem;
    border-radius: 0.75rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, border-color 0.2s ease;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    box-sizing: border-box;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }

  .card:hover h3 {
    color: var(--accent);
  }

  .tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    font-weight: 700;
    background-color: var(--accent-glow);
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    border: 1px solid var(--border-color);
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    color: var(--accent);
    font-weight: 700;
    transition: color 0.2s ease;
  }

  .card p {
    color: var(--text-main);
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0 0 1rem;
  }

  .date {
    font-size: 0.75rem;
    color: var(--text-muted);
    opacity: 0.8;
  }

  .page-btn {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--accent);
    font-weight: 700;
    padding: 0.6rem 1.25rem;
    border-radius: 9999px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .page-btn:hover {
    background-color: var(--accent);
    color: #000000;
    border-color: var(--accent);
  }

  .footer-advanced {
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-color);
    color: var(--text-muted);
    margin-top: auto;
    padding: 3rem 2rem 1.5rem;
  }

  .footer-container {
    max-width: 1150px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }

  .footer-col h3, .footer-col h4 {
    color: var(--accent);
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }

  .footer-col p {
    font-size: 0.85rem;
    line-height: 1.6;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-col ul li {
    margin-bottom: 0.6rem;
  }

  .footer-col ul li a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
    transition: color 0.2s ease;
  }

  .footer-col ul li a:hover {
    color: var(--accent);
  }

  .footer-badge {
    display: inline-block;
    background-color: var(--accent-glow);
    color: var(--accent);
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    border: 1px solid var(--border-color);
  }

  .update-info {
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    color: var(--text-main);
  }

  .footer-search-box input {
    width: 100%;
    background-color: var(--bg-base);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }

  .footer-search-box input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 8px var(--accent-glow);
  }

  .footer-bottom {
    max-width: 1150px;
    margin: 0 auto;
    border-top: 1px solid var(--border-color);
    padding-top: 1.5rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
